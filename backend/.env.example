# 复制一份改名为 .env 再填值。
# 规则：.env 永远不进仓库；这份 .env.example 必须进仓库。

# ---- 运行 ----
DEMO_MODE=true
CORS_ORIGINS=*
UPLOAD_MAX_MB=20

# ---- 识别模型（D2 用）----
# 走 OpenAI 兼容协议，换供应商只改 base_url + model
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-max

# ---- 文本模型（D6 编排器 / D9 意见生成用）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
