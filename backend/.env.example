# 复制一份改名为 .env 再填值。
# 规则：.env 永远不进仓库；这份 .env.example 必须进仓库。

# ---- 运行 ----
DEMO_MODE=true
CORS_ORIGINS=*
UPLOAD_MAX_MB=20

# ---- 识别模型（D2 用）----
# 走 OpenAI 兼容协议，换供应商只改 base_url + model，代码一行不动。
# 留空则自动降级到 mock：链路照样能跑通，但结果里的 provider 会写 mock-vlm。
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-max
VLM_TIMEOUT_S=60
# 有些供应商不支持 response_format=json_object，报错会自动去掉重试一次
VLM_FORCE_JSON=true

# ---- 抽取策略 ----
IMAGE_MAX_EDGE=1024       # 长边压到这个尺寸，票面文字仍然清楚
CONFIDENCE_THRESHOLD=0.8  # 整体把握低于这个就转人工，不让机器下结论
EXTRACT_MAX_RETRY=1       # 校验不过时最多回灌重试几次
EXTRACT_CACHE=true        # 同一张图第二次进来直接命中缓存（演示很关键）

# ---- 文本模型（D6 编排器 / D9 意见生成用）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat