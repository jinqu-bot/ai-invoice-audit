# Copy to backend/.env. Never commit real secrets.
# Process environment variables take precedence.
DEMO_MODE=true
CORS_ORIGINS=*
UPLOAD_MAX_MB=20

# OpenAI-compatible vision service. Empty key/URL uses mock-vlm.
# Mock does not read images. Model name below is an example default.
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=qwen-vl-max
VLM_TIMEOUT_S=60
VLM_MAX_TOKENS=4000
VLM_EFFORT=
VLM_VERIFY_HEADER=false
VLM_FORCE_JSON=true

IMAGE_MAX_EDGE=1024
CONFIDENCE_THRESHOLD=0.8
EXTRACT_MAX_RETRY=1
EXTRACT_CACHE=true

# Variants: 0, 1, 2, over_std, dup, header_err, non_invoice
MOCK_VARIANT=

# Text model for policy QA and optional tool planning
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_S=60

# Empty values use backend/data/app.db and backend/data/uploads.
# Prefer explicit absolute writable paths for deployment.
DB_PATH=
UPLOAD_DIR=
