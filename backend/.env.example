# 复制一份改名为 .env 再填值。
# 规则：.env 永远不进仓库；这份 .env.example 必须进仓库。

# ---- 运行 ----
DEMO_MODE=true
CORS_ORIGINS=*
UPLOAD_MAX_MB=20

# ---- 识别模型（D2 用）----
# 走 OpenAI 兼容协议，换供应商只改 base_url + model，代码一行不动。
# 留空则自动降级到 mock：链路照样能跑通，但结果里的 provider 会写 mock-vlm。
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-max
VLM_TIMEOUT_S=60
# 有些供应商不支持 response_format=json_object，报错会自动去掉重试一次
VLM_FORCE_JSON=true

# ---- 抽取策略 ----
# 长边压到这个尺寸，票面文字仍然清楚
IMAGE_MAX_EDGE=1024
# 整体把握低于这个就转人工，不让机器下结论
CONFIDENCE_THRESHOLD=0.8
# 校验不过时最多回灌重试几次
EXTRACT_MAX_RETRY=1
# 同一张图第二次进来直接命中缓存（演示很关键）
EXTRACT_CACHE=true

# ---- 没有 key 时的调试开关 ----
# 把 mock 的返回值钉死，用来验证某条分支；留空则按图片指纹取样。
#   0 / 1 / 2      三张干净样例票（住宿 680 / 招待 358 / 交通 78.5）
#   over_std       住宿 1280，会命中 R5 超标准 → 黄灯
#   dup            发票号 66472890，在台账里已有 → 命中 R1 重复报销 → 红灯
#   header_err     抬头写成"杭州云帆网络科技有限公司" → 命中 R3 → 红灯
#   non_invoice    这不是发票 → 转人工
# 注意：mock 不看图片内容，它证明不了识别准不准，只能证明链路通不通。
MOCK_VARIANT=

# ---- 文本模型（D6 编排器 / D9 意见生成用）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat